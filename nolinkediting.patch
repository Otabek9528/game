From c2d635bbdad4e3e54a02d9f4a5109920f83ea09a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 18 Aug 2026 13:43:58 +0000
Subject: [PATCH] Fix social links once set: no user correction path
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A link that already works could be re-proposed by anyone, which produced
churn to review and a trickle of competing values for the same field.
Once a link is set it now stays set, and changes go through the admin.

Removes the pencil from connected tiles, along with its styles. The note
keeps its correction path — hours and announcements go stale, links do
not.
---
 pages/places/places-detail.css | 37 ----------------------------------
 pages/places/places-detail.js  | 21 ++++---------------
 2 files changed, 4 insertions(+), 54 deletions(-)

diff --git a/pages/places/places-detail.css b/pages/places/places-detail.css
index dfeb9dc..5a6fddb 100644
--- a/pages/places/places-detail.css
+++ b/pages/places/places-detail.css
@@ -776,36 +776,6 @@
 
 .pd-social-tile--pending .pd-social-state { white-space: normal; line-height: 1.25; }
 
-/* --- Correction affordance on a connected tile --- */
-.pd-social-edit {
-  position: absolute;
-  top: 5px;
-  right: 5px;
-  z-index: 2;
-  width: 26px;
-  height: 26px;
-  display: flex;
-  align-items: center;
-  justify-content: center;
-  padding: 0;
-  border: none;
-  border-radius: 50%;
-  background: var(--pl-surface);
-  color: var(--pl-muted);
-  box-shadow: 0 1px 4px rgba(28, 25, 23, 0.14);
-  cursor: pointer;
-  opacity: 0.75;
-  transition: opacity 160ms ease, color 160ms ease, transform 160ms var(--pl-ease);
-}
-
-.pd-social-edit:hover {
-  opacity: 1;
-  color: var(--pl-accent);
-  transform: scale(1.08);
-}
-
-.pd-social-edit .pl-icon { width: 0.78rem; height: 0.78rem; }
-
 /* =========================================================
    OWNER NOTE
    ========================================================= */
@@ -1141,7 +1111,6 @@
 
 .pd-social-tile--empty:focus-visible,
 .pd-social-link:focus-visible,
-.pd-social-edit:focus-visible,
 .pd-note-cta:focus-visible,
 .pd-sheet-btn:focus-visible,
 .pd-sheet-input:focus-visible,
@@ -1152,7 +1121,6 @@
 
 @media (prefers-reduced-motion: reduce) {
   .pd-social-tile,
-  .pd-social-edit,
   .pd-sheet,
   .pd-sheet-backdrop,
   .pd-toast {
@@ -1195,11 +1163,6 @@
 
 .night-mode .pd-social-tile--pending { background: rgba(234, 185, 50, 0.1); }
 
-.night-mode .pd-social-edit {
-  background: var(--pl-surface-2);
-  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
-}
-
 .night-mode .pd-sheet-icon--tiktok { color: #f1f1ef; }
 
 .night-mode .pd-sheet { box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.6); }
diff --git a/pages/places/places-detail.js b/pages/places/places-detail.js
index 0992777..a701629 100644
--- a/pages/places/places-detail.js
+++ b/pages/places/places-detail.js
@@ -969,7 +969,6 @@ console.log('✅ Places Detail JS loaded');
 
   function buildTile(p) {
     var value = place ? place[p.prop] : null;
-    var locked = isPending(p.field);   // a correction is already queued
 
     var tile = document.createElement('div');
     tile.className = 'pd-social-tile pd-social-tile--on pd-social-tile--' + p.field;
@@ -1001,22 +1000,10 @@ console.log('✅ Places Detail JS loaded');
     });
     tile.appendChild(link);
 
-    // No pencil while a change to this field is already queued — a second
-    // submission would only bounce off the one-pending-per-field rule.
-    if (!locked) {
-      var edit = document.createElement('button');
-      edit.type = 'button';
-      edit.className = 'pd-social-edit';
-      edit.setAttribute('aria-label',
-        t('detail.social.suggestEdit', 'O\'zgartirish taklif qilish') + ' — ' + p.label);
-      edit.innerHTML = PD_ICONS.pen;
-      edit.addEventListener('click', function (e) {
-        e.preventDefault();
-        e.stopPropagation();
-        openSheet(p.field, value);
-      });
-      tile.appendChild(edit);
-    }
+    // No correction affordance: once a link is set it is fixed, and changes go
+    // through the admin rather than back through the queue. Letting anyone
+    // re-propose a link that already works produced churn to review and a
+    // steady trickle of competing values for the same field.
     return tile;
   }
 
-- 
2.43.0

