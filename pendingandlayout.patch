+.pd-social-grid--2 { grid-template-columns: repeat(2, 1fr); }
+.pd-social-grid--3 { grid-template-columns: repeat(3, 1fr); }
+
+.pd-social-text {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 3px;
+  min-width: 0;
+  max-width: 100%;
+}
+
+.pd-social-grid--1 .pd-social-tile { min-height: 74px; }
+
+.pd-social-grid--1 .pd-social-link {
+  flex-direction: row;
+  justify-content: flex-start;
+  gap: 14px;
+  padding: 16px 18px;
+}
+
+.pd-social-grid--1 .pd-social-text { align-items: flex-start; }
+.pd-social-grid--1 .pd-social-icon .pl-icon { width: 30px; height: 30px; }
+.pd-social-grid--1 .pd-social-name { font-size: 0.95rem; }
+.pd-social-grid--1 .pd-social-state { font-size: 0.8rem; }
+
+/* The single tile is a row, so it needs no fixed height — let the link set it. */
+.pd-social-grid--1 .pd-social-tile::after {
+  content: '';
+  display: block;
+  padding-top: 0;
+}
+
 /* One box for all three states, so a filled and an empty tile line up. */
