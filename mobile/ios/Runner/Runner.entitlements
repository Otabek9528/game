<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (Firebase over APNs). Xcode switches this to
	     "production" when it exports an App Store build. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Shared with the home-screen widget: the prayer times it shows. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.vegukin.muslimVegukin</string>
	</array>
</dict>
</plist>
