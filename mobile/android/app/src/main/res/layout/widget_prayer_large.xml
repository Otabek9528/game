<?xml version="1.0" encoding="utf-8"?>
<!-- Large (4×2) home-screen widget. Filled in by widget/PrayerWidgets.kt.
     Only views RemoteViews allows: FrameLayout, LinearLayout, TextView,
     ImageView, Chronometer. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-46dp"
        android:layout_marginEnd="-34dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_rosette" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="13dp"
        android:paddingEnd="16dp"
        android:paddingBottom="11dp">

        <!-- Bot + name, and the city (tap: open the app, refresh location). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_bot" />

            <!-- Shrinks to fit narrow launchers (Android 8+) rather than cut. -->
            <TextView
                android:id="@+id/brand"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="14.5sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFamily="@font/playfair_display_bold"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/widget_brand"
                android:textColor="@color/widget_ink"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/city_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_pin" />

                <TextView
                    android:id="@+id/city"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:ellipsize="end"
                    android:maxWidth="110dp"
                    android:maxLines="1"
                    android:textColor="@color/widget_accent"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_refresh" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Countdown (left) and the day's dates (right). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/until"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:maxLines="1"
                    android:textColor="@color/widget_accent"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <!-- Shrinks when the wait is 10 hours or more (winter nights). -->
                <Chronometer
                    android:id="@+id/countdown"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:autoSizeMaxTextSize="34sp"
                    android:autoSizeMinTextSize="22sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:countDown="true"
                    android:fontFeatureSettings="tnum"
                    android:gravity="bottom"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="4dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/date_line1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/widget_soft"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/date_line2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/widget_faint"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- The day: six windows, the current one highlighted. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout android:id="@+id/cell_0" style="@style/WidgetCell">
                <TextView android:id="@+id/name_0" style="@style/WidgetCellName" />
                <TextView android:id="@+id/time_0" style="@style/WidgetCellTime" />
            </LinearLayout>

            <LinearLayout android:id="@+id/cell_1" style="@style/WidgetCell">
                <TextView android:id="@+id/name_1" style="@style/WidgetCellName" />
                <TextView android:id="@+id/time_1" style="@style/WidgetCellTime" />
            </LinearLayout>

            <LinearLayout android:id="@+id/cell_2" style="@style/WidgetCell">
                <TextView android:id="@+id/name_2" style="@style/WidgetCellName" />
                <TextView android:id="@+id/time_2" style="@style/WidgetCellTime" />
            </LinearLayout>

            <LinearLayout android:id="@+id/cell_3" style="@style/WidgetCell">
                <TextView android:id="@+id/name_3" style="@style/WidgetCellName" />
                <TextView android:id="@+id/time_3" style="@style/WidgetCellTime" />
            </LinearLayout>

            <LinearLayout android:id="@+id/cell_4" style="@style/WidgetCell">
                <TextView android:id="@+id/name_4" style="@style/WidgetCellName" />
                <TextView android:id="@+id/time_4" style="@style/WidgetCellTime" />
            </LinearLayout>

            <LinearLayout android:id="@+id/cell_5" style="@style/WidgetCell">
                <TextView android:id="@+id/name_5" style="@style/WidgetCellName" />
                <TextView android:id="@+id/time_5" style="@style/WidgetCellTime" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/rail"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="5dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />
    </LinearLayout>

    <include layout="@layout/widget_prayer_empty" />
</FrameLayout>
