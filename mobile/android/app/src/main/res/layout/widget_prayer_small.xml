<?xml version="1.0" encoding="utf-8"?>
<!-- Small (2×2) home-screen widget. Filled in by widget/PrayerWidgets.kt. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-54dp"
        android:layout_marginEnd="-44dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_rosette" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="11dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_emblem" />

            <!-- Shrinks on narrow launchers rather than being cut. -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:contentDescription="@string/widget_brand"
                android:scaleType="fitStart"
                android:src="@drawable/ic_widget_wordmark" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/until"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:autoSizeMaxTextSize="10.5sp"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:textColor="@color/widget_accent"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/countdown"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:autoSizeMaxTextSize="40sp"
            android:autoSizeMinTextSize="20sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:countDown="true"
            android:fontFeatureSettings="tnum"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/widget_soft"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/rail"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <!-- City (tap: open the app, refresh location) and the date. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/city_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_pin" />

                <TextView
                    android:id="@+id/city"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:ellipsize="end"
                    android:maxWidth="90dp"
                    android:maxLines="1"
                    android:textColor="@color/widget_accent"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginStart="3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_refresh" />
            </LinearLayout>

            <!-- Gives way to the city when the widget is narrow. -->
            <TextView
                android:id="@+id/date_short"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/widget_faint"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/widget_prayer_empty" />
</FrameLayout>
