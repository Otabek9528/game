<?xml version="1.0" encoding="utf-8"?>
<!-- Small (2×2) home-screen widget. Filled in by widget/PrayerWidgets.kt. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-50dp"
        android:layout_marginEnd="-40dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_rosette" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_bot" />

            <!-- Shrinks to fit narrow launchers (Android 8+) rather than cut. -->
            <TextView
                android:id="@+id/brand"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFamily="@font/playfair_display_bold"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/widget_brand"
                android:textColor="@color/widget_ink"
                android:textSize="10sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/until"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:textColor="@color/widget_accent"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/countdown"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:autoSizeMaxTextSize="30sp"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:countDown="true"
            android:fontFeatureSettings="tnum"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/widget_soft"
            android:textSize="12sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/rail"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <!-- City (tap: open the app, refresh location) and the date. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/city_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_pin" />

                <TextView
                    android:id="@+id/city"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:ellipsize="end"
                    android:maxWidth="80dp"
                    android:maxLines="1"
                    android:textColor="@color/widget_accent"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_refresh" />
            </LinearLayout>

            <!-- Gives way to the city when the widget is narrow. -->
            <TextView
                android:id="@+id/date_short"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/widget_faint"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/widget_prayer_empty" />
</FrameLayout>
