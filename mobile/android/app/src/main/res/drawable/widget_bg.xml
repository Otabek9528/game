<?xml version="1.0" encoding="utf-8"?>
<!-- Light mode: parchment, warmed by a gold glow. Dark mode: drawable-night/. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FFFFFFFF"
                android:endColor="#FFF7F3EC" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Light from the top right, behind the rosette. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.92"
                android:centerY="0.0"
                android:endColor="#00000000"
                android:gradientRadius="230dp"
                android:startColor="@color/widget_glow"
                android:type="radial" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/widget_edge" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
