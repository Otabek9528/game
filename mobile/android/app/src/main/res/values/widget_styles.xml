<?xml version="1.0" encoding="utf-8"?>
<!-- One prayer window in the large widget's strip (layout/widget_prayer_large.xml). -->
<resources>
    <style name="WidgetCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">1dp</item>
        <item name="android:layout_marginEnd">1dp</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
        <!-- Air between neighbours, however narrow the launcher. -->
        <item name="android:paddingStart">3dp</item>
        <item name="android:paddingEnd">3dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- Sizes are set by PrayerWidgets.render to fit the widget's width. -->
    <style name="WidgetCellName">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_faint</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetCellTime">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
