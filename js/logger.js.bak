// js/logger.js - Centralized logging utility with fetch + keepalive
(function() {
  'use strict';
  
  const API_ENDPOINT = 'https://vegukin-api.duckdns.org/api/log-interaction';
  const tg = window.Telegram?.WebApp;
  
  console.log('🔧 Logger script loaded');
  console.log('🔧 Telegram WebApp available:', !!tg);
  console.log('🔧 User data:', tg?.initDataUnsafe?.user);
  
  // Map page paths to action names
  const PAGE_TO_ACTION = {
    'pages/places/places.html': 'places',
    'pages/prayers.html': 'prayers',
    'pages/qibla/qibla.html': 'qibla',
    'pages/parcel/parcel.html': 'parcel',
    'pages/links/links.html': 'links',
    'pages/job-group/job-group.html': 'jobs',
    'pages/donation/donation.html': 'donation',
    'pages/barcode/barcode.html': 'barcode',
    'pages/community/community.html': 'community',
    'pages/ramadan/ramadan.html': 'ramadan'
  };
  
  /**
   * Log user interaction using fetch with keepalive
   * @param {string} action - Action identifier (e.g., 'mosque', 'prayers')
   */
  function logInteraction(action) {
    console.log('📊 logInteraction() called with action:', action);
    
    try {
      const user = tg?.initDataUnsafe?.user;
      
      if (!user) {
        console.warn('⚠️ No user data available for logging');
        console.log('🔧 tg object:', tg);
        console.log('🔧 initDataUnsafe:', tg?.initDataUnsafe);
        return;
      }
      
      const payload = {
        user_id: user.id,
        username: user.username || user.first_name || 'unknown',
        action: action
      };
      
      console.log('🔧 Payload to send:', payload);
      console.log('🔧 API endpoint:', API_ENDPOINT);
      
      // Use fetch with keepalive - guarantees delivery even after navigation
      fetch(API_ENDPOINT, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload),
        keepalive: true  // Critical: ensures request completes even if page navigates
      })
      .then(response => {
        console.log('🔧 Response status:', response.status);
        console.log('🔧 Response ok:', response.ok);
        
        if (response.ok) {
          console.log('✅ Log successful:', action);
        } else {
          console.warn('⚠️ Server returned non-OK status:', response.status);
        }
        
        return response.json();
      })
      .then(data => {
        console.log('🔧 Response data:', data);
      })
      .catch(err => {
        console.error('❌ Log failed:', err);
        console.log('🔧 Error details:', err.message);
      });
      
    } catch (e) {
      console.error('❌ Logger exception:', e);
      console.log('🔧 Exception details:', e.message, e.stack);
    }
  }
  
  /**
   * Detect current page and return action name
   */
  function detectPageAction() {
    const pathname = window.location.pathname;
    const params = new URLSearchParams(window.location.search);
    
    console.log('🔧 detectPageAction()');
    console.log('🔧 pathname:', pathname);
    console.log('🔧 search params:', params.toString());
    
    // Priority 1: Check URL parameter ?action=
    const actionParam = params.get('action');
    if (actionParam) {
      console.log('✅ Action from URL parameter:', actionParam);
      return actionParam;
    }
    
    // Priority 2: Check for places.html with ?type= parameter
    if (pathname.includes('places/places.html')) {
      const type = params.get('type');
      console.log('🔧 places.html detected, type:', type);
      if (type) {
        console.log('✅ Action from type parameter:', type);
        return type; // Returns 'mosque', 'restaurant', or 'shop'
      }
      console.log('⚠️ places.html but no type, using fallback');
      return 'places';
    }
    
    // Priority 3: Match page path to action
    for (const [path, action] of Object.entries(PAGE_TO_ACTION)) {
      if (pathname.includes(path)) {
        console.log('✅ Action from path match:', action);
        return action;
      }
    }
    
    // Priority 4: Main page - don't log
    if (pathname === '/' || pathname.includes('index.html')) {
      console.log('ℹ️ Main page - not logging');
      return null;
    }
    
    console.warn('⚠️ No action detected for pathname:', pathname);
    return null;
  }
  
  /**
   * Auto-log on page load
   */
  function autoLog() {
    console.log('🔧 autoLog() started');
    
    const action = detectPageAction();
    
    if (action) {
      // Skip if index.html already logged this action pre-navigation
      const guardKey = 'logged_' + action;
      try {
        if (sessionStorage.getItem(guardKey) === '1') {
          sessionStorage.removeItem(guardKey);
          console.log('ℹ️ Skipping auto-log — already logged pre-navigation:', action);
          // Still clean URL if action param exists
          const params = new URLSearchParams(window.location.search);
          if (params.has('action')) {
            params.delete('action');
            const cleanUrl = params.toString()
              ? `${window.location.pathname}?${params.toString()}`
              : window.location.pathname;
            window.history.replaceState({}, '', cleanUrl);
          }
          return;
        }
      } catch (e) { /* sessionStorage unavailable — fall through and log */ }
      
      console.log('📍 Auto-logging action:', action);
      logInteraction(action);
      
      // Clean URL if action parameter exists
      const params = new URLSearchParams(window.location.search);
      if (params.has('action')) {
        console.log('🔧 Cleaning URL - removing action parameter');
        params.delete('action');
        const cleanUrl = params.toString() 
          ? `${window.location.pathname}?${params.toString()}`
          : window.location.pathname;
        
        window.history.replaceState({}, '', cleanUrl);
        console.log('🔧 URL cleaned to:', cleanUrl);
      }
    } else {
      console.log('ℹ️ No action to log for this page');
    }
  }
  
  // Run on page load
  if (document.readyState === 'loading') {
    console.log('🔧 Waiting for DOMContentLoaded...');
    document.addEventListener('DOMContentLoaded', autoLog);
  } else {
    console.log('🔧 DOM already loaded, running autoLog immediately');
    autoLog();
  }
  
  // Expose globally for manual logging
  window.logInteraction = logInteraction;
  
  console.log('✅ Logger initialized');
})();