+
+/* =========================================================
+   SOCIAL LINKS + OWNER NOTE  (community submitted)
+   Reuses the --pl- tokens from places.css. Brand colour is
+   used only for the glyph and a soft tint, so the row still
+   reads as part of the emerald/sand card rather than three
+   logos pasted onto it.
+   ========================================================= */
+
+.pd-social-grid {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 10px;
+}
+
+/* One box for all three states, so a filled and an empty tile line up. */
+.pd-social-tile {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+  min-height: 96px;
+  padding: 14px 8px 12px;
+  border-radius: 16px;
+  border: 1.5px solid var(--pl-line);
+  background: var(--pl-surface);
+  font-family: inherit;
+  text-align: center;
+  transition: transform 160ms var(--pl-ease), border-color 160ms ease,
+              background 160ms ease, box-shadow 160ms ease;
+}
+
+.pd-social-link {
+  position: absolute;
+  inset: 0;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+  padding: 14px 8px 12px;
+  border-radius: 15px;
+  text-decoration: none;
+  color: inherit;
+}
+
+.pd-social-icon {
+  line-height: 0;
+  color: var(--pl-muted);
+  transition: color 160ms ease;
+}
+
+.pd-social-icon .pl-icon { width: 26px; height: 26px; }
+
+.pd-social-name {
+  font-size: 0.82rem;
+  font-weight: 700;
+  color: var(--pl-text);
+  letter-spacing: -0.01em;
+}
+
+.pd-social-state {
+  font-size: 0.7rem;
+  color: var(--pl-muted);
+  max-width: 100%;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.pd-social-state--add {
+  display: inline-flex;
+  align-items: center;
+  gap: 3px;
+  color: var(--pl-accent);
+  font-weight: 600;
+}
+
+.pd-social-state--add .pl-icon { width: 0.78rem; height: 0.78rem; }
+
+/* --- Connected --- */
+.pd-social-tile--on {
+  border-color: transparent;
+  background: var(--pl-surface-2);
+  cursor: pointer;
+}
+
+.pd-social-tile--on:hover {
+  transform: translateY(-2px);
+  box-shadow: var(--pl-shadow-card);
+}
+
+.pd-social-tile--on:active { transform: translateY(0); }
+
+.pd-social-tile--telegram  { background: rgba(42, 171, 238, 0.10); }
+.pd-social-tile--telegram  .pd-social-icon { color: #2aabee; }
+.pd-social-tile--tiktok    { background: rgba(20, 20, 20, 0.07); }
+.pd-social-tile--tiktok    .pd-social-icon { color: #111111; }
+.pd-social-tile--instagram { background: rgba(214, 41, 118, 0.09); }
+.pd-social-tile--instagram .pd-social-icon { color: #d62976; }
+
+/* --- Empty: dashed, clearly an invitation rather than a dead tile --- */
+.pd-social-tile--empty {
+  border-style: dashed;
+  border-color: var(--pl-line);
+  background: transparent;
+  cursor: pointer;
+}
+
+.pd-social-tile--empty:hover {
+  border-color: var(--pl-accent);
+  background: var(--pl-accent-soft);
+}
+
+.pd-social-tile--empty:hover .pd-social-icon { color: var(--pl-accent); }
+.pd-social-tile--empty:active { transform: scale(0.97); }
+
+/* --- Awaiting review --- */
+.pd-social-tile--pending {
+  border-style: dashed;
+  border-color: var(--pl-gold);
+  background: rgba(212, 162, 26, 0.07);
+}
+
+.pd-social-tile--pending .pd-social-icon,
+.pd-social-tile--pending .pd-social-state { color: var(--pl-gold); }
+
+.pd-social-tile--pending .pd-social-state { white-space: normal; line-height: 1.25; }
+
+/* --- Correction affordance on a connected tile --- */
+.pd-social-edit {
+  position: absolute;
+  top: 5px;
+  right: 5px;
+  z-index: 2;
+  width: 26px;
+  height: 26px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 0;
+  border: none;
+  border-radius: 50%;
+  background: var(--pl-surface);
+  color: var(--pl-muted);
+  box-shadow: 0 1px 4px rgba(28, 25, 23, 0.14);
+  cursor: pointer;
+  opacity: 0.75;
+  transition: opacity 160ms ease, color 160ms ease, transform 160ms var(--pl-ease);
+}
+
+.pd-social-edit:hover {
+  opacity: 1;
+  color: var(--pl-accent);
+  transform: scale(1.08);
+}
+
+.pd-social-edit .pl-icon { width: 0.78rem; height: 0.78rem; }
+
+/* =========================================================
+   OWNER NOTE
+   ========================================================= */
+
+.pd-note-card {
+  background: var(--pl-accent-soft);
+  border-left: 3px solid var(--pl-accent);
+  border-radius: 10px;
+  padding: 13px 15px;
+}
+
+.pd-note-text {
+  margin: 0;
+  font-size: 0.92rem;
+  line-height: 1.65;
+  color: var(--pl-text);
+  /* Newlines come from the stored note verbatim — the text is set with
+     textContent, so this is what keeps "Mon-Fri / Sat" on separate lines
+     without ever building markup from user input. */
+  white-space: pre-line;
+  overflow-wrap: anywhere;
+}
+
+.pd-note-empty {
+  margin: 0 0 12px 0;
+  font-size: 0.88rem;
+  line-height: 1.55;
+  color: var(--pl-muted);
+}
+
+.pd-note-cta {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  margin-top: 12px;
+  padding: 8px 15px;
+  border: 1.5px dashed var(--pl-line);
+  border-radius: var(--pl-radius-sm);
+  background: transparent;
+  color: var(--pl-accent);
+  font-family: inherit;
+  font-size: 0.82rem;
+  font-weight: 600;
+  cursor: pointer;
+  transition: border-color 160ms ease, background 160ms ease;
+}
+
+.pd-note-cta:hover {
+  border-color: var(--pl-accent);
+  background: var(--pl-accent-soft);
+}
+
+.pd-note-cta:active { transform: scale(0.98); }
+.pd-note-cta .pl-icon { width: 0.85rem; height: 0.85rem; }
+
+.pd-pending-chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  margin-top: 12px;
+  padding: 7px 13px;
+  border-radius: var(--radius-full, 9999px);
+  background: rgba(212, 162, 26, 0.12);
+  color: var(--pl-gold);
+  font-size: 0.78rem;
+  font-weight: 600;
+}
+
+.pd-pending-chip .pl-icon { width: 0.85rem; height: 0.85rem; }
+
+/* =========================================================
+   SUBMISSION SHEET
+   Same idiom as the prayer settings sheet: scrim, rounded
+   sheet rising from the bottom, grab handle.
+   ========================================================= */
+
+.pd-sheet-backdrop {
+  position: fixed;
+  inset: 0;
+  z-index: 300;
+  background: var(--pl-scrim);
+  opacity: 0;
+  transition: opacity 250ms ease;
+}
+
+.pd-sheet-backdrop.visible { opacity: 1; }
+.pd-sheet-backdrop[hidden] { display: none; }
+
+.pd-sheet {
+  position: fixed;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  z-index: 301;
+  max-width: 520px;
+  margin: 0 auto;
+  background: var(--pl-surface);
+  border-radius: 22px 22px 0 0;
+  box-shadow: 0 -8px 40px rgba(20, 24, 22, 0.28);
+  transform: translateY(100%);
+  transition: transform 300ms cubic-bezier(0.32, 0.72, 0, 1);
+  max-height: 88vh;
+  display: flex;
+  flex-direction: column;
+  /* Clears the iOS home indicator and Telegram's own bottom chrome. */
+  padding-bottom: env(safe-area-inset-bottom, 0px);
+}
+
+.pd-sheet.visible { transform: translateY(0); }
+
+.pd-sheet-grip {
+  padding: 10px 0 2px;
+  display: flex;
+  justify-content: center;
+  cursor: grab;
+  touch-action: none;
+  flex-shrink: 0;
+}
+
+.pd-sheet-grip-bar {
+  width: 38px;
+  height: 4px;
+  border-radius: 999px;
+  background: var(--pl-line);
+}
+
+.pd-sheet-head {
+  display: flex;
+  align-items: center;
+  gap: 11px;
+  padding: 8px 20px 14px;
+  border-bottom: 1px solid var(--pl-line);
+  flex-shrink: 0;
+}
+
+.pd-sheet-icon {
+  line-height: 0;
+  color: var(--pl-accent);
+  flex-shrink: 0;
+}
+
+.pd-sheet-icon .pl-icon { width: 22px; height: 22px; }
+.pd-sheet-icon--telegram  { color: #2aabee; }
+.pd-sheet-icon--tiktok    { color: #111111; }
+.pd-sheet-icon--instagram { color: #d62976; }
+
+.pd-sheet-title {
+  margin: 0;
+  font-size: 1.02rem;
+  font-weight: 700;
+  color: var(--pl-text);
+  letter-spacing: -0.01em;
+}
+
+.pd-sheet-body {
+  padding: 16px 20px 4px;
+  overflow-y: auto;
+  -webkit-overflow-scrolling: touch;
+}
+
+.pd-sheet-current {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+  margin-bottom: 13px;
+  padding: 9px 13px;
+  border-radius: 10px;
+  background: var(--pl-surface-2);
+}
+
+.pd-sheet-current[hidden] { display: none; }
+
+.pd-sheet-current-label {
+  font-size: 0.68rem;
+  font-weight: 700;
+  color: var(--pl-muted);
+  text-transform: uppercase;
+  letter-spacing: 0.08em;
+  flex-shrink: 0;
+}
+
+.pd-sheet-current-value {
+  font-size: 0.86rem;
+  color: var(--pl-text-2);
+  overflow-wrap: anywhere;
+  white-space: pre-line;
+}
+
+.pd-sheet-input,
+.pd-sheet-textarea {
+  width: 100%;
+  padding: 13px 15px;
+  border: 1.5px solid var(--pl-line);
+  border-radius: 12px;
+  background: var(--pl-bg);
+  color: var(--pl-text);
+  font-family: inherit;
+  /* 16px keeps iOS Safari from zooming the viewport on focus. */
+  font-size: 16px;
+  outline: none;
+  transition: border-color 160ms ease, box-shadow 160ms ease;
+  box-sizing: border-box;
+}
+
+.pd-sheet-textarea {
+  resize: vertical;
+  min-height: 108px;
+  line-height: 1.55;
+}
+
+.pd-sheet-input:focus,
+.pd-sheet-textarea:focus {
+  border-color: var(--pl-accent);
+  box-shadow: 0 0 0 3px var(--pl-accent-soft);
+}
+
+.pd-sheet-input::placeholder,
+.pd-sheet-textarea::placeholder { color: var(--pl-muted); }
+
+.pd-sheet-meta {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 12px;
+  margin-top: 7px;
+}
+
+.pd-sheet-hint {
+  font-size: 0.75rem;
+  color: var(--pl-muted);
+  line-height: 1.45;
+}
+
+.pd-sheet-counter {
+  font-size: 0.72rem;
+  color: var(--pl-muted);
+  font-variant-numeric: tabular-nums;
+  flex-shrink: 0;
+}
+
+.pd-sheet-counter--near { color: var(--pl-gold); font-weight: 600; }
+
+.pd-sheet-error {
+  margin: 11px 0 0 0;
+  padding: 10px 13px;
+  border-radius: 10px;
+  background: rgba(194, 69, 58, 0.09);
+  border-left: 3px solid #c2453a;
+  color: #a9382e;
+  font-size: 0.82rem;
+  line-height: 1.5;
+}
+
+.pd-sheet-error[hidden] { display: none; }
+
+.pd-sheet-moderation {
+  margin: 14px 0 0 0;
+  font-size: 0.76rem;
+  line-height: 1.5;
+  color: var(--pl-muted);
+}
+
+.pd-sheet-actions {
+  display: flex;
+  gap: 10px;
+  padding: 14px 20px 20px;
+  flex-shrink: 0;
+}
+
+.pd-sheet-btn {
+  flex: 1;
+  padding: 13px 18px;
+  border: none;
+  border-radius: 12px;
+  font-family: inherit;
+  font-size: 0.94rem;
+  font-weight: 700;
+  cursor: pointer;
+  transition: filter 160ms ease, transform 160ms var(--pl-ease), opacity 160ms ease;
+}
+
+.pd-sheet-btn--ghost {
+  background: var(--pl-surface-2);
+  color: var(--pl-text-2);
+}
+
+.pd-sheet-btn--ghost:hover { filter: brightness(0.97); }
+
+.pd-sheet-btn--primary {
+  background: var(--pl-accent);
+  color: #fff;
+  flex: 1.4;
+}
+
+.pd-sheet-btn--primary:hover { filter: brightness(1.05); }
+.pd-sheet-btn:active { transform: translateY(1px); }
+
+.pd-sheet-btn:disabled {
+  opacity: 0.6;
+  cursor: not-allowed;
+  transform: none;
+}
+
+/* =========================================================
+   TOAST
+   ========================================================= */
+
+.pd-toast {
+  position: fixed;
+  left: 50%;
+  bottom: calc(26px + env(safe-area-inset-bottom, 0px));
+  transform: translate(-50%, 14px);
+  z-index: 400;
+  max-width: 90vw;
+  padding: 12px 20px;
+  border-radius: var(--radius-full, 9999px);
+  background: var(--sand-800, #292524);
+  color: #fff;
+  font-size: 0.86rem;
+  line-height: 1.4;
+  text-align: center;
+  box-shadow: var(--shadow-lg, 0 8px 24px rgba(28, 25, 23, 0.1));
+  opacity: 0;
+  transition: opacity 250ms ease, transform 250ms ease;
+}
+
+.pd-toast.visible { opacity: 1; transform: translate(-50%, 0); }
+.pd-toast[hidden] { display: none; }
+
+/* =========================================================
+   ACCESSIBILITY & MOTION  (extras)
+   ========================================================= */
+
+.pd-social-tile--empty:focus-visible,
+.pd-social-link:focus-visible,
+.pd-social-edit:focus-visible,
+.pd-note-cta:focus-visible,
+.pd-sheet-btn:focus-visible,
+.pd-sheet-input:focus-visible,
+.pd-sheet-textarea:focus-visible {
+  outline: 2px solid var(--pl-accent);
+  outline-offset: 2px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .pd-social-tile,
+  .pd-social-edit,
+  .pd-sheet,
+  .pd-sheet-backdrop,
+  .pd-toast {
+    transition: none;
+  }
+}
+
+/* =========================================================
+   SMALL SCREENS  (extras)
+   ========================================================= */
+
+@media (max-width: 420px) {
+  .pd-social-grid { gap: 8px; }
+  .pd-social-tile { min-height: 88px; padding: 12px 5px 10px; }
+  .pd-social-icon .pl-icon { width: 23px; height: 23px; }
+  .pd-social-name { font-size: 0.76rem; }
+  .pd-social-state { font-size: 0.65rem; }
+  .pd-sheet-actions { padding: 12px 16px 18px; }
+  .pd-sheet-body { padding: 14px 16px 4px; }
+  .pd-sheet-head { padding: 8px 16px 12px; }
+}
+
+/* =========================================================
+   NIGHT MODE
+   ========================================================= */
+
+.night-mode .pd-social-tile { background: var(--pl-surface); }
+
+.night-mode .pd-social-tile--on { background: rgba(255, 255, 255, 0.05); }
+
+.night-mode .pd-social-tile--telegram  { background: rgba(42, 171, 238, 0.15); }
+.night-mode .pd-social-tile--telegram  .pd-social-icon { color: #4fc0f5; }
+/* The TikTok mark is black; on a dark card it needs to invert or it vanishes. */
+.night-mode .pd-social-tile--tiktok    { background: rgba(255, 255, 255, 0.09); }
+.night-mode .pd-social-tile--tiktok    .pd-social-icon { color: #f1f1ef; }
+.night-mode .pd-social-tile--instagram { background: rgba(214, 41, 118, 0.16); }
+.night-mode .pd-social-tile--instagram .pd-social-icon { color: #f06fa4; }
+
+.night-mode .pd-social-tile--empty { background: transparent; }
+
+.night-mode .pd-social-tile--pending { background: rgba(234, 185, 50, 0.1); }
+
+.night-mode .pd-social-edit {
+  background: var(--pl-surface-2);
+  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
+}
+
+.night-mode .pd-sheet-icon--tiktok { color: #f1f1ef; }
+
+.night-mode .pd-sheet { box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.6); }
+
+.night-mode .pd-sheet-error {
+  background: rgba(232, 124, 115, 0.12);
+  border-left-color: #e87c73;
+  color: #e87c73;
+}
+
+.night-mode .pd-toast {
+  background: #2a2a2a;
+  border: 1px solid var(--pl-line);
+}
